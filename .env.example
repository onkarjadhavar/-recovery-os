# RecoveryOS Environment Configuration Template
# Copy this file to .env for local deployment with live Razorpay Test Mode or Gemini AI
# If left empty or omitted, RecoveryOS safely defaults to the offline Test Mode Emulator.

# Server Settings
PORT=8000
ENVIRONMENT=development

# Razorpay Test Mode Credentials (Optional - Emulator used if empty)
# Never use production/live keys in hackathon evaluation!
RAZORPAY_KEY_ID=rzp_test_sim_demo12345
RAZORPAY_KEY_SECRET=sim_secret_demo67890
RAZORPAY_WEBHOOK_SECRET=whsec_sim_recoveryos

# Optional LLM Enhancement (Deterministic diagnostic classifier active by default)
GEMINI_API_KEY=

# Deterministic Policy Engine Guardrail Invariants
MAX_AUTO_RECOVERY_AMOUNT=5000.0
MAX_RETRY_ATTEMPTS=2
MIN_AI_CONFIDENCE=0.85
FRAUD_RISK_CUTOFF=0.35
